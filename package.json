{
  "name": "delton",
  "version": "1.0.0",
  "description": "Delton motion design studio: CashWise pitch and showreel render pipeline",
  "main": "index.js",
  "scripts": {
    "vo": "python3 audio/voiceover.py --engine elevenlabs",
    "vo:standin": "python3 audio/voiceover.py --engine piper",
